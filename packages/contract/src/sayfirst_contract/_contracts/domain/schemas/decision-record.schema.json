{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An append-only authoritative decision record.",
  "properties": {
    "arguments_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "const": "authoritative"
    },
    "capability": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$",
      "type": "string"
    },
    "contract_generation": {
      "minimum": 1,
      "type": "integer"
    },
    "correlation": {
      "maxLength": 128,
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_source": {
      "description": "Who chose the bytes of correlation: the boundary that asked, or nobody. The daemon cannot prove a supplied value is an identifier; this marks its provenance.",
      "enum": [
        "boundary_supplied",
        "absent"
      ],
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision_ref": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "evaluation_recipe": {
      "description": "The identifier of the evaluation recipe the decision was taken under; a reader that does not know it reports the record as unverifiable, never evaluates it under other semantics.",
      "minLength": 1,
      "type": "string"
    },
    "grant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "suspend"
      ],
      "type": "string"
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "principal": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "uid": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "uid",
        "name"
      ],
      "type": "object"
    },
    "principal_references": {
      "description": "The principal references the evaluation read, sorted and unique: the caller's own reference intersected with the references named by every rule for the asked scope and capability (M3). Recorded so a reader can re-derive the answer without a directory.",
      "items": {
        "maxLength": 262,
        "minLength": 6,
        "type": "string"
      },
      "maxItems": 131072,
      "type": "array",
      "uniqueItems": true
    },
    "reason": {
      "enum": [
        "policy_allows",
        "policy_denies",
        "policy_absent",
        "policy_requires_review",
        "capability_unknown",
        "approval_granted",
        "approval_rejected"
      ],
      "type": "string"
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "contract_generation",
    "authority",
    "decision_ref",
    "scope",
    "capability",
    "outcome",
    "reason",
    "policy_version",
    "decided_at",
    "correlation",
    "principal",
    "arguments_digest",
    "rule_id",
    "grant_id"
  ],
  "title": "Decision record",
  "type": "object",
  "x-contract-generation": 1,
  "x-spdx-license-identifier": "Apache-2.0"
}
